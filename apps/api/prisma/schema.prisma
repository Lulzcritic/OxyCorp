
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobType {
  MINING
  REFINING
}

enum JobStatus {
  ACTIVE
  COMPLETED
}

enum SectorType {
  EMPTY
  BUNKER
  RESOURCE
  POI
}

model Sector {
  id        String     @id @default(uuid())
  x         BigInt
  y         BigInt
  type      SectorType
  ownerId   String?
  resources Json?
  hasOutpost Boolean   @default(false)
  jobs      Job[]

  owner    User?      @relation(fields: [ownerId], references: [id])

  @@unique([x, y])
  @@map("sectors")
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  credits        BigInt      @default(1000)
  bunker_level   Int         @default(1)
  specialization String?     // MVP: 'COGITATOR' | 'FORGE' | 'MERCHANT' | null
  xp             BigInt      @default(0)
  skillPoints    Int         @default(0) @map("skill_points")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  inventory        Inventory[]
  jobs             Job[]
  listings         MarketListing[]
  swarms           Swarm[]
  sectors          Sector[]
  bunkerFacilities BunkerFacility[]
  quests           Quest[]
  userSkills       UserSkills[]

  @@map("users")
}

model UserSkills {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  level     Int      @default(1)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Swarm {
  id        String   @id @default(uuid())
  userId    String
  name      String
  formation Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@map("swarms")
}

model MarketListing {
  id           String   @id @default(uuid())
  sellerId     String
  itemId       String
  quantity     BigInt
  pricePerUnit BigInt
  isBuyOrder   Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  seller       User     @relation(fields: [sellerId], references: [id])

  @@map("market_listings")
}

model TransactionHistory {
  id        String   @id @default(uuid())
  buyerId   String
  sellerId  String
  itemId    String
  quantity  BigInt
  totalPrice BigInt
  date      DateTime @default(now())

  @@map("transaction_history")
}

model Inventory {
  id        String   @id @default(uuid())
  userId    String
  item      String
  quantity  BigInt   @default(0)
  
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, item])
  @@map("inventory")
}

model Job {
  id              String    @id @default(uuid())
  userId          String
  type            JobType
  status          JobStatus
  startedAt       DateTime  @default(now()) @map("started_at")
  durationSeconds Int       @map("duration_seconds")
  rewardItemId    String    @map("reward_item_id")
  sectorId        String?   @map("sector_id")
  data            Json?
  
  user            User      @relation(fields: [userId], references: [id])
  sector          Sector?   @relation(fields: [sectorId], references: [id])

  @@map("jobs")
}

enum FacilityType {
  REFINING_VAT
  LOGISTICS_HUB
  COMMAND_ARRAY
}

model BunkerFacility {
  id        String       @id @default(uuid())
  userId    String
  type      FacilityType
  level     Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("bunker_facilities")
}

enum QuestType {
  MINING
  REFINING
  COMBAT
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model Quest {
  id        String      @id @default(uuid())
  userId    String
  type      QuestType
  target    Json        // { item: string, count: number }
  reward    Json        // { credits: number, xp: number }
  progress  Int         @default(0) // Current count towards target
  status    QuestStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id])

  @@map("quests")
}


